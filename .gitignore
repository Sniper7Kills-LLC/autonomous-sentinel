# Dependencies
node_modules/
.pnp
.pnp.*

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Amplify Gen 2 generated artifacts
# Note: `amplify_outputs.json` is intentionally tracked — it carries the
# public Cognito IDs + Amplify app ARNs that ship to every browser
# client anyway, and the web workspace imports it at compile time so CI
# typecheck depends on it being present. Local `ampx sandbox` runs do
# overwrite it; use `git update-index --skip-worktree amplify_outputs.json`
# to ignore sandbox-driven churn without untracking the file.
.amplify/
amplify/.amplify/

# Electron build artifacts
upload-client/release/
upload-client/dist-electron/

# Environment + secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
logs/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Coverage
coverage/
*.lcov

# Misc
.cache/
.turbo/

# Claude Code per-developer overrides
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/


# CDK synth output
infra/*/cdk.out/
